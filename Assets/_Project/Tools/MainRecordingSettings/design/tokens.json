{
  "$schema": "fbx2vmd-design-tokens/v1",
  "description": "FBX2VMD 디자인 시스템 의미 토큰 정본 — styles.css 토큰 존과 tokenConsistency.test.mjs가 1:1 정합을 강제한다. 다른 스택(Flet/Flutter/USS) 산출물은 이 파일에서 생성한다.",
  "color": {
    "page":        { "light": "#eef2f6", "dark": "#0e0f16", "css": "--page-color", "scope": "root" },
    "line":        { "light": "#d8e0e8", "dark": "#262b3d", "css": "--line-color", "scope": "root" },
    "text":        { "light": "#2f3b49", "dark": "#e8eaf2", "css": "--body-text", "scope": "root" },
    "muted":       { "light": "#9aa2ab", "dark": "#6b7190", "css": "--muted-text", "scope": "root" },
    "accent":      { "light": "#3d3984", "dark": "#7a76e0", "css": "--active-color", "scope": "root" },
    "lbAccent":    { "light": "#3d3984", "dark": "#5a56e0", "css": "--lb-accent" },
    "card":        { "light": "#ffffff", "dark": "#1a1d29", "css": "--lb-card" },
    "cardHead":    { "light": "#f7f9fd", "dark": "#1e2130", "css": "--lb-card-head" },
    "inset":       { "light": "#f4f6f9", "dark": "#14161f", "css": "--lb-inset" },
    "hover":       { "light": "#eef2f7", "dark": "#232738", "css": "--lb-hover" },
    "border":      { "light": "#d9e1ea", "dark": "#262b3d", "css": "--lb-border" },
    "borderSoft":  { "light": "#edf1f5", "dark": "#20243a", "css": "--lb-border-soft" },
    "textStrong":  { "light": "#273444", "dark": "#e8eaf2", "css": "--lb-text" },
    "textSub":     { "light": "#536173", "dark": "#9aa0b4", "css": "--lb-text-2" },
    "textFaint":   { "light": "#6d7482", "dark": "#868ca2", "css": "--lb-text-3" },
    "accentHover": { "light": "#4a4982", "dark": "#6a66ea", "css": "--lb-accent-hover" },
    "accentDim":   { "light": "#e7e9f7", "dark": "#2a2a52", "css": "--lb-accent-dim" },
    "accentText":  { "light": "#3d3984", "dark": "#b7b4f2", "css": "--lb-accent-text" },
    "onAccent":    { "light": "#ffffff", "dark": "#ffffff", "css": "--lb-on-accent" },
    "ok":          { "light": "#168251", "dark": "#2dd4a7", "css": "--lb-ok" },
    "chipOkText":  { "light": "#047857", "dark": "#34d399", "css": "--lb-chip-ok-text" },
    "warn":        { "light": "#8a5b00", "dark": "#c9a86a", "css": "--lb-warn" },
    "track":       { "light": "#e2e8f0", "dark": "#2e3347", "css": "--lb-track" },
    "danger":      { "light": "#dc2626", "dark": "#f87171", "css": "--lb-danger-text" }
  },
  "font": {
    "family": "Malgun Gothic, Apple SD Gothic Neo, Noto Sans KR, system-ui, sans-serif",
    "mono": "JetBrains Mono, Consolas, monospace"
  },
  "radius": { "sm": 4, "md": 8, "lg": 16, "xl": 24 }
}
